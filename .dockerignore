# The build context of every image in this repository is the repository root,
# because both images need `external/alpaca-mcp-server/`.
# Keep `external/`, `src/`, and `docker/` in the context.

# Build output and IDE state
build/
**/bin/
**/obj/
.vs/
.vscode/
**/*.*proj.user
**/*.dbmdl
**/*.jfm

# Version control
**/.git
**/.gitignore
**/.gitattributes
.github/

# Secrets. Credentials reach the containers as environment variables.
**/.env
**/secrets.dev.yaml
**/values.dev.yaml

# Project memory and documents. No image needs them.
.lode/
*.md
LICENSE

# The old Alpaca CLI. It is a fallback only. No code calls it.
cli_0.0.14_windows_amd64/

# Alpaca MCP server parts that the runtime does not need
external/alpaca-mcp-server/tests/
external/alpaca-mcp-server/assets/
external/alpaca-mcp-server/charts/
external/alpaca-mcp-server/scripts/

# Docker files themselves
**/.dockerignore
**/Dockerfile*
compose*.yaml

# `uv sync` reads the readme that pyproject.toml declares.
!external/alpaca-mcp-server/README.md
