# Copy to .env and fill in the keys. .env is git-ignored.
# Use the development paper account here, not the official competition account.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Must stay true. The host also verifies paper mode after it connects.
ALPACA_PAPER_TRADE=true

# ---------------------------------------------------------------- the war room
#
# The room seats five. Four are models, and they run on THREE DIFFERENT PROVIDERS
# on purpose: a room of one model arguing with itself shares that model's blind
# spots (ADR-020). So all three keys below are needed, not just the first.
#
#   proposer  Claude Opus 5     ANTHROPIC_API_KEY
#   skeptic   Claude Sonnet 5   ANTHROPIC_API_KEY
#   quant     GPT-5.6-terra     OPENAI_API_KEY
#   market    Grok 4.6          XAI_API_KEY
#   exposure  plain C#          no key, no cost
#
# `--live` and `--replay --agent llm` REFUSE TO START if any of these is missing,
# and name the ones it could not find. That check is deliberate: a seat without a
# key is a dead seat, and the failure belongs before the open, not at 09:31.
#
# To run without any of them, pass `--agent stub`. The stub claims no edge and
# exists to exercise the plumbing.
#
# Never commit a real key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
